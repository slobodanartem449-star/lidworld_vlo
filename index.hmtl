<!DOCTYPE html>
<html lang="ru" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LeadWorld — Зимнее выживание и моды</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        ice: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            cyan: '#00f0ff',
                            blueglow: '#0088ff',
                            dark: '#030712',
                            card: 'rgba(11, 20, 38, 0.78)',
                            border: 'rgba(56, 189, 248, 0.2)'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030712;
            color: #e2e8f0;
            overflow-x: hidden;
        }
        .ice-glow {
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.25);
        }
        .text-ice-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #38bdf8 50%, #00f0ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glass-card {
            background: rgba(10, 20, 40, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.18);
        }
        .glass-card:hover {
            border-color: rgba(0, 240, 255, 0.45);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.18);
        }
        #snow-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }
        .frost-corner {
            position: absolute;
            width: 150px;
            height: 150px;
            pointer-events: none;
            background: radial-gradient(circle, rgba(0,240,255,0.18) 0%, transparent 70%);
            z-index: 2;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #030712;
        }
        ::-webkit-scrollbar-thumb {
            background: #0ea5e9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
    </style>
</head>
<body class="bg-ice-dark text-slate-100 min-h-screen flex flex-col relative selection:bg-ice-500 selection:text-white">

    <canvas id="snow-canvas"></canvas>
    <div class="frost-corner top-0 left-0"></div>
    <div class="frost-corner top-0 right-0"></div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-32 opacity-0 transition-all duration-300 glass-card text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border-ice-cyan/40">
        <div class="w-8 h-8 rounded-full bg-ice-500/25 text-ice-cyan flex items-center justify-center">
            <i class="fa-solid fa-snowflake animate-spin"></i>
        </div>
        <div>
            <h4 class="font-bold text-sm">Морозный успех!</h4>
            <p id="toast-msg" class="text-xs text-slate-300">Действие выполнено успешно</p>
        </div>
    </div>

    <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-xl border-b border-sky-500/15">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between relative z-10">
            <!-- Logo -->
            <div class="flex items-center gap-3 cursor-pointer group" onclick="switchTab('home')">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-700 flex items-center justify-center ice-glow group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-snowflake text-xl text-white animate-pulse"></i>
                </div>
                <div>
                    <span class="text-2xl font-black tracking-wider text-ice-gradient">LEAD<span class="text-ice-cyan">WORLD</span></span>
                    <span class="block text-[10px] tracking-widest text-sky-300 uppercase font-semibold">Winter Edition</span>
                </div>
            </div>

            <!-- Nav Links -->
            <nav class="hidden lg:flex items-center gap-1.5 glass-card p-1.5 rounded-2xl">
                <button onclick="switchTab('home')" id="nav-home" class="nav-btn px-4 py-2 rounded-xl text-sm font-medium transition-all text-ice-cyan bg-sky-500/20 shadow-inner">Главная</button>
                <button onclick="switchTab('visuals')" id="nav-visuals" class="nav-btn px-4 py-2 rounded-xl text-sm font-medium transition-all text-slate-300 hover:text-white hover:bg-sky-500/10">Визуалы и моды</button>
                <button onclick="switchTab('donate')" id="nav-donate" class="nav-btn px-4 py-2 rounded-xl text-sm font-medium transition-all text-slate-300 hover:text-white hover:bg-sky-500/10">Донат</button>
                <button onclick="switchTab('rules')" id="nav-rules" class="nav-btn px-4 py-2 rounded-xl text-sm font-medium transition-all text-slate-300 hover:text-white hover:bg-sky-500/10">Правила</button>
            </nav>

            <!-- Header Actions -->
            <div class="flex items-center gap-3">
                <button onclick="copyIP()" class="hidden sm:flex items-center gap-2.5 glass-card hover:border-ice-cyan px-4 py-2.5 rounded-xl text-sm font-medium transition-all group">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
                    <span class="text-sky-200 group-hover:text-white font-mono">play.leadworld.su</span>
                    <i class="fa-regular fa-copy text-sky-400 group-hover:text-ice-cyan ml-1"></i>
                </button>

                <!-- Auth container -->
                <div id="auth-header-container" class="flex items-center gap-2">
                    <button onclick="openModal('login')" class="glass-card hover:border-ice-cyan text-sky-200 hover:text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-all">
                        Войти
                    </button>
                    <button onclick="openModal('register')" class="bg-gradient-to-r from-sky-400 to-ice-cyan hover:from-sky-300 hover:to-cyan-300 text-slate-950 font-extrabold px-4 py-2.5 rounded-xl text-sm shadow-lg shadow-sky-500/25 transition-all">
                        Регистрация
                    </button>
                </div>

                <button onclick="toggleMobileMenu()" class="lg:hidden text-sky-300 hover:text-white p-2 text-xl">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
        <!-- Mobile Dropdown -->
        <div id="mobile-menu" class="hidden lg:hidden glass-card border-b border-sky-500/20 px-4 py-4 space-y-2 relative z-10">
            <button onclick="switchTab('home'); toggleMobileMenu();" class="block w-full text-left px-4 py-2 rounded-xl text-sm font-medium text-slate-200 hover:bg-sky-500/20">Главная</button>
            <button onclick="switchTab('visuals'); toggleMobileMenu();" class="block w-full text-left px-4 py-2 rounded-xl text-sm font-medium text-slate-200 hover:bg-sky-500/20">Визуалы и моды</button>
            <button onclick="switchTab('donate'); toggleMobileMenu();" class="block w-full text-left px-4 py-2 rounded-xl text-sm font-medium text-slate-200 hover:bg-sky-500/20">Донат</button>
            <button onclick="switchTab('rules'); toggleMobileMenu();" class="block w-full text-left px-4 py-2 rounded-xl text-sm font-medium text-slate-200 hover:bg-sky-500/20">Правила</button>
        </div>
    </header>

    <main class="flex-grow relative z-10">

        <!-- ================= HOME TAB ================= -->
        <div id="tab-home" class="tab-content">
            <section class="relative pt-16 pb-24 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-sky-500/10 via-transparent to-transparent pointer-events-none"></div>
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                            <div class="inline-flex items-center gap-2.5 glass-card px-4 py-2 rounded-full text-ice-cyan text-xs font-semibold uppercase tracking-wider border-sky-400/30">
                                <i class="fa-solid fa-snowflake text-sky-400 animate-spin"></i> Зимний сезон 2026 • Версия 1.16 - 1.20+
                            </div>
                            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-none">
                                ПОГРУЗИСЬ В ЛЕДЯНУЮ СКАЗКУ <span class="text-ice-gradient">LEADWORLD</span>
                            </h1>
                            <p class="text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal">
                                Легендарный зимний сервер Minecraft с уникальными морозными привилегиями, защитой региона и продвинутой поддержкой клиентских визуалов.
                            </p>
                            
                            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
                                <button onclick="copyIP()" class="w-full sm:w-auto bg-gradient-to-r from-cyan-400 to-sky-500 hover:from-cyan-300 hover:to-sky-400 text-slate-950 font-extrabold px-8 py-4 rounded-2xl text-base shadow-xl ice-glow transition-all transform hover:-translate-y-1 flex items-center justify-center gap-3">
                                    <i class="fa-solid fa-play text-slate-950"></i> Начать играть (IP)
                                </button>
                                <button onclick="switchTab('visuals')" class="w-full sm:w-auto glass-card hover:border-ice-cyan text-white font-semibold px-8 py-4 rounded-2xl text-base transition-all flex items-center justify-center gap-3">
                                    <i class="fa-solid fa-eye text-ice-cyan"></i> Разрешенные моды
                                </button>
                            </div>

                            <div class="pt-6 flex items-center justify-center lg:justify-start gap-8 border-t border-sky-500/20">
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></div>
                                    <div>
                                        <div class="text-2xl font-bold text-white"><span id="online-count">1,894</span> / 2500</div>
                                        <div class="text-xs text-sky-300">Игроков онлайн</div>
                                    </div>
                                </div>
                                <div class="h-8 w-px bg-sky-500/20"></div>
                                <div>
                                    <div class="text-2xl font-bold text-white">20.0 TPS</div>
                                    <div class="text-xs text-sky-300">Стабильность мира</div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Widget -->
                        <div class="lg:col-span-5 flex justify-center">
                            <div class="relative w-full max-w-md">
                                <div class="absolute -inset-2 bg-gradient-to-r from-sky-500 to-blue-600 rounded-3xl blur-2xl opacity-25 animate-pulse"></div>
                                <div class="relative glass-card rounded-3xl p-6 shadow-2xl overflow-hidden border-sky-400/30">
                                    <div class="flex items-center justify-between mb-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-400 to-blue-600 flex items-center justify-center text-white font-black text-xl ice-glow">
                                                LW
                                            </div>
                                            <div>
                                                <h3 class="font-bold text-white">LeadWorld Winter</h3>
                                                <span class="text-xs text-ice-cyan font-medium">Версия: 1.16.5 - 1.20+</span>
                                            </div>
                                        </div>
                                        <span class="px-3 py-1 bg-sky-500/20 text-ice-cyan border border-sky-400/30 text-xs font-bold rounded-full">FROST LIVE</span>
                                    </div>
                                    
                                    <div class="bg-slate-950/80 border border-sky-500/30 rounded-2xl p-4 mb-6 flex items-center justify-between">
                                        <div>
                                            <span class="text-xs text-sky-400 block mb-1 font-mono">АДРЕС СЕРВЕРА:</span>
                                            <code class="text-ice-cyan font-mono font-bold text-base">play.leadworld.su</code>
                                        </div>
                                        <button onclick="copyIP()" class="bg-sky-500/20 hover:bg-sky-500/40 text-ice-cyan p-3 rounded-xl transition-all border border-sky-400/30" title="Скопировать IP">
                                            <i class="fa-regular fa-copy text-lg"></i>
                                        </button>
                                    </div>

                                    <div class="space-y-3">
                                        <div class="flex items-center justify-between text-sm bg-slate-900/50 p-3 rounded-xl border border-sky-500/10">
                                            <span class="text-slate-400">Режим игры</span>
                                            <span class="font-semibold text-white">Зимнее выживание</span>
                                        </div>
                                        <div class="flex items-center justify-between text-sm bg-slate-900/50 p-3 rounded-xl border border-sky-500/10">
                                            <span class="text-slate-400">Защита модов</span>
                                            <span class="font-semibold text-sky-300">AntiCheat FrostGuard</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= VISUALS & MODS TAB (NEW) ================= -->
        <div id="tab-visuals" class="tab-content hidden py-16">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <span class="text-ice-cyan text-xs font-bold tracking-widest uppercase mb-3 block">КЛИЕНТСКИЕ МОДИФИКАЦИИ</span>
                    <h2 class="text-3xl sm:text-4xl font-ext500 tracking-tight text-white">Визуалы и разрешенные моды</h2>
                    <p class="text-slate-400 mt-3">Полный список модификаций, которые разрешены для повышения FPS и графики, а также строго запрещенных читов.</p>
                </div>

                <!-- Filter buttons -->
                <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
                    <button onclick="filterMods('all')" id="filter-all" class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-sky-500 text-slate-950 shadow-md">Все моды</button>
                    <button onclick="filterMods('allowed')" id="filter-allowed" class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all glass-card text-emerald-400 hover:border-emerald-500/50">Разрешенные визуалы</button>
                    <button onclick="filterMods('forbidden')" id="filter-forbidden" class="px-5 py-2.5 rounded-xl text-sm font-semibold transition-all glass-card text-rose-400 hover:border-rose-500/50">Запрещенные читы</button>
                </div>

                <!-- Mods Grid -->
                <div id="mods-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Mod 1 -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item" data-category="allowed">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-sky-500/20 text-ice-cyan flex items-center justify-center text-xl font-bold border border-sky-400/30">
                                    <i class="fa-solid fa-gauge-high"></i>
                                </div>
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-check"></i> Разрешено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">Sodium / Lithium</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Оптимизационный мод для графического движка Fabric. Значительно увеличивает кадры в секунду (FPS) и устраняет микрофризы в заснеженных биомах.
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-sky-500/10 text-xs text-sky-300 flex items-center justify-between">
                            <span>Тип: Оптимизация</span>
                            <span class="text-emerald-400 font-semibold">Безопасно</span>
                        </div>
                    </div>

                    <!-- Mod 2 -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item" data-category="allowed">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center text-xl font-bold border border-cyan-400/30">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </div>
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-check"></i> Разрешено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">Iris Shaders</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Мод для подключения реалистичных шейдеров. Позволяет наслаждаться красивыми зимними лучами света, динамическими тенями и падающими снежинками.
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-sky-500/10 text-xs text-sky-300 flex items-center justify-between">
                            <span>Тип: Визуальный графический</span>
                            <span class="text-emerald-400 font-semibold">Безопасно</span>
                        </div>
                    </div>

                    <!-- Mod 3 -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item" data-category="allowed">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-blue-500/20 text-blue-300 flex items-center justify-center text-xl font-bold border border-blue-400/30">
                                    <i class="fa-solid fa-user-gear"></i>
                                </div>
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-check"></i> Разрешено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">3D Skin Layers</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Косметический мод, добавляющий объемный 3D-рельеф для элементов одежды на скинах игроков (шлемы, плащи, накидки).
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-sky-500/10 text-xs text-sky-300 flex items-center justify-between">
                            <span>Тип: Косметика</span>
                            <span class="text-emerald-400 font-semibold">Безопасно</span>
                        </div>
                    </div>

                    <!-- Mod 4 -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item" data-category="allowed">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-sky-400/20 text-ice-cyan flex items-center justify-center text-xl font-bold border border-sky-400/30">
                                    <i class="fa-solid fa-compass"></i>
                                </div`>
                                <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-check"></i> Разрешено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">Xaero's Minimap</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Удобная минимапа и карта мира с возможностью ставить путевые точки. Помогает ориентироваться в морозных лесах LeadWorld.
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-sky-500/10 text-xs text-sky-300 flex items-center justify-between">
                            <span>Тип: Навигация</span>
                            <span class="text-emerald-400 font-semibold">Безопасно</span>
                        </div>
                    </div>

                    <!-- Mod 5 (Forbidden) -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item border-rose-500/30" data-category="forbidden">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 flex items-center justify-center text-xl font-bold border border-rose-500/30">
                                    <i class="fa-solid fa-eye-slash"></i>
                                </div>
                                <span class="px-3 py-1 bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-ban"></i> Запрещено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">X-Ray (Икс-Рей)</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Модификации и ресурспаки, позволяющие видеть сквозь стены текстуры руд и подземелий. Античит автоматически обнаруживает и банит аккаунт.
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-rose-500/20 text-xs text-rose-300 flex items-center justify-between">
                            <span>Тип: Читы</span>
                            <span class="text-rose-400 font-semibold">Перманентный бан</span>
                        </div>
                    </div>

                    <!-- Mod 6 (Forbidden) -->
                    <div class="glass-card p-6 rounded-3xl flex flex-col justify-between transition-all group mod-item border-rose-500/30" data-category="forbidden">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 flex items-center justify-center text-xl font-bold border border-rose-500/30">
                                    <i class="fa-solid fa-bolt"></i>
                                </div>
                                <span class="px-3 py-1 bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-bold rounded-full flex items-center gap-1.5">
                                    <i class="fa-solid fa-ban"></i> Запрещено
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2">Killaura / Fly / Speed</h3>
                            <p class="text-slate-300 text-sm leading-relaxed mb-6">
                                Любые боевые и мувмент-читы (автоатака по нескольким целям, полет без привилегий, ускорение шагов). Наказываются без предупреждения.
                            </p>
                        </div>
                        <div class="bg-slate-950/60 p-3 rounded-xl border border-rose-500/20 text-xs text-rose-300 flex items-center justify-between">
                            <span>Тип: Читы</span>
                            <span class="text-rose-400 font-semibold">Перманентный бан</span>
                        </div>
