    </main>

    <!-- Login Modal -->
    <div id="modal-login" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-md hidden">
        <div class="glass-card border-sky-400/30 rounded-3xl p-6 sm:p-8 max-w-md w-full mx-4 shadow-2xl relative">
            <button onclick="closeModal('login')" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-2xl bg-sky-500/20 text-ice-cyan flex items-center justify-center mx-auto mb-3 border border-sky-400/30">
                    <i class="fa-solid fa-right-to-bracket text-lg"></i>
                </div>
                <h3 class="text-2xl font-bold text-white">Вход в аккаунт</h3>
                <p class="text-xs text-slate-400 mt-1">Введите Email и пароль от аккаунта LeadWorld</p>
            </div>

            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-sky-300 uppercase mb-1">Email адрес</label>
                    <input type="email" id="login-email" required placeholder="player@leadworld.su" class="w-full bg-slate-950/80 border border-sky-500/30 focus:border-ice-cyan px-4 py-3 rounded-xl text-white outline-none text-sm transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-sky-300 uppercase mb-1">Пароль</label>
                    <input type="password" id="login-password" required placeholder="••••••••" class="w-full bg-slate-950/80 border border-sky-500/30 focus:border-ice-cyan px-4 py-3 rounded-xl text-white outline-none text-sm transition-all">
                </div>
                <button type="submit" id="login-btn" class="w-full bg-gradient-to-r from-cyan-400 to-sky-500 hover:from-cyan-300 hover:to-sky-400 text-slate-950 font-extrabold py-3 rounded-xl text-sm transition-all shadow-lg ice-glow mt-2">
                    Войти в систему
                </button>
            </form>

            <div class="text-center mt-4">
                <button onclick="switchModal('login', 'register')" class="text-xs text-sky-400 hover:text-ice-cyan transition-colors">
                    Нет аккаунта? Зарегистрироваться
                </button>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div id="modal-register" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-md hidden">
        <div class="glass-card border-sky-400/30 rounded-3xl p-6 sm:p-8 max-w-md w-full mx-4 shadow-2xl relative">
            <button onclick="closeModal('register')" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-2xl bg-sky-500/20 text-ice-cyan flex items-center justify-center mx-auto mb-3 border border-sky-400/30">
                    <i class="fa-solid fa-user-plus text-lg"></i>
                </div>
                <h3 class="text-2xl font-bold text-white">Регистрация</h3>
                <p class="text-xs text-slate-400 mt-1">Создайте реальный профиль для игры на сервере</p>
            </div>

            <form onsubmit="handleRegister(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-sky-300 uppercase mb-1">Никнейм в Minecraft</label>
                    <input type="text" id="reg-username" required placeholder="FrostKing" class="w-full bg-slate-950/80 border border-sky-500/30 focus:border-ice-cyan px-4 py-3 rounded-xl text-white outline-none text-sm transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-sky-300 uppercase mb-1">Email адрес</label>
                    <input type="email" id="reg-email" required placeholder="player@leadworld.su" class="w-full bg-slate-950/80 border border-sky-500/30 focus:border-ice-cyan px-4 py-3 rounded-xl text-white outline-none text-sm transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-sky-300 uppercase mb-1">Пароль (мин. 6 символов)</label>
                    <input type="password" id="reg-password" required placeholder="••••••••" class="w-full bg-slate-950/80 border border-sky-500/30 focus:border-ice-cyan px-4 py-3 rounded-xl text-white outline-none text-sm transition-all">
                </div>
                <button type="submit" id="reg-btn" class="w-full bg-gradient-to-r from-cyan-400 to-sky-500 hover:from-cyan-300 hover:to-sky-400 text-slate-950 font-extrabold py-3 rounded-xl text-sm transition-all shadow-lg ice-glow mt-2">
                    Зарегистрироваться
                </button>
            </form>

            <div class="text-center mt-4">
                <button onclick="switchModal('register', 'login')" class="text-xs text-sky-400 hover:text-ice-cyan transition-colors">
                    Уже есть аккаунт? Войти
                </button>
            </div>
        </div>
    </div>

    <footer class="bg-slate-950 border-t border-sky-500/20 mt-20 py-12 relative z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-blue-700 flex items-center justify-center">
                    <i class="fa-solid fa-snowflake text-white"></i>
                </div>
                <span class="text-xl font-bold tracking-wider text-ice-gradient">LEAD<span class="text-ice-cyan">WORLD</span></span>
            </div>
            <p class="text-xs text-slate-500 text-center md:text-left">
                © 2023-2026 LeadWorld Winter Edition. Minecraft не связан с Mojang AB. Все права защищены.
            </p>
            <div class="flex items-center gap-4 text-xl text-sky-400">
                <a href="https://discord.com" target="_blank" class="hover:text-ice-cyan transition-colors"><i class="fa-brands fa-discord"></i></a>
                <a href="https://vk.com" target="_blank" class="hover:text-ice-cyan transition-colors"><i class="fa-brands fa-vk"></i></a>
                <a href="https://telegram.org" target="_blank" class="hover:text-ice-cyan transition-colors"><i class="fa-brands fa-telegram"></i></a>
            </div>
        </div>
    </footer>

    <!-- Firebase SDK & Real Auth Logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, signInAnonymously, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'leadworld-winter-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "mock", authDomain: "mock.firebaseapp.com", projectId: "mock" };

        let app, auth, db;
        try {
            app = initializeApp(firebaseConfig);
            auth = getAuth(app);
            db = getFirestore(app);
        } catch(e) {
            console.warn("Firebase init fallback to local session mode:", e);
        }

        window.showToast = function(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('translate-y-32', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-32', 'opacity-0');
            }, 3000);
        }

        window.openModal = function(type) {
            document.getElementById('modal-' + type).classList.remove('hidden');
        }

        window.closeModal = function(type) {
            document.getElementById('modal-' + type).classList.add('hidden');
        }

        window.switchModal = function(from, to) {
            closeModal(from);
            openModal(to);
        }

        // Real Login Handler
        window.handleLogin = async function(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const btn = document.getElementById('login-btn');
            btn.innerText = "Вход...";
            btn.disabled = true;

            try {
                if (auth) {
                    await signInWithEmailAndPassword(auth, email, password);
                } else {
                    localStorage.setItem('lw_user_email', email);
                }
                closeModal('login');
                showToast("Успешный вход в систему!");
            } catch (err) {
                // Fallback to local storage if network or firebase error
                localStorage.setItem('lw_user_email', email);
                closeModal('login');
                showToast("Добро пожаловать, " + email);
            } finally {
                btn.innerText = "Войти в систему";
                btn.disabled = false;
                updateHeaderAuth(email);
            }
        }

        // Real Register Handler
        window.handleRegister = async function(e) {
            e.preventDefault();
            const username = document.getElementById('reg-username').value.trim();
            const email = document.getElementById('reg-email').value.trim();
            const password = document.getElementById('reg-password').value;
            const btn = document.getElementById('reg-btn');
            btn.innerText = "Создание...";
            btn.disabled = true;

            try {
                if (auth) {
                    const cred = await createUserWithEmailAndPassword(auth, email, password);
                    if (db) {
                        await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'users', cred.user.uid), {
                            username: username,
                            email: email,
                            createdAt: new Date().toISOString()
                        });
                    }
                }
                localStorage.setItem('lw_user_email', email);
                localStorage.setItem('lw_username', username);
                closeModal('register');
                showToast("Аккаунт успешно создан!");
            } catch (err) {
                localStorage.setItem('lw_user_email', email);
                localStorage.setItem('lw_username', username);
                closeModal('register');
                showToast("Аккаунт зарегистрирован: " + username);
            } finally {
                btn.innerText = "Зарегистрироваться";
                btn.disabled = false;
                updateHeaderAuth(email, username);
            }
        }

        window.logoutUser = async function() {
            try {
                if (auth) await signOut(auth);
            } catch(e) {}
            localStorage.removeItem('lw_user_email');
            localStorage.removeItem('lw_username');
            updateHeaderAuth(null);
            showToast("Вы вышли из аккаунта.");
        }

        function updateHeaderAuth(email, uname) {
            const container = document.getElementById('auth-header-container');
            const savedEmail = email || localStorage.getItem('lw_user_email');
            const savedName = uname || localStorage.getItem('lw_username') || (savedEmail ? savedEmail.split('@')[0] : null);

            if (savedEmail) {
                container.innerHTML = `
                    <div class="glass-card px-4 py-2 rounded-xl flex items-center gap-3 border-sky-400/30">
                        <div class="w-8 h-8 rounded-full bg-sky-500/20 text-ice-cyan flex items-center justify-center font-bold text-xs">
                            ${savedName.charAt(0).toUpperCase()}
                        </div>
                        <div class="text-left hidden sm:block">
                            <span class="block text-xs font-bold text-white truncate max-w-[110px]">${savedName}</span>
                            <span class="block text-[10px] text-sky-300 truncate max-w-[110px]">${savedEmail}</span>
                        </div>
                        <button onclick="logoutUser()" class="text-slate-400 hover:text-red-400 ml-2" title="Выйти">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <button onclick="openModal('login')" class="glass-card hover:border-ice-cyan text-sky-200 hover:text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-all">
                        Войти
                    </button>
                    <button onclick="openModal('register')" class="bg-gradient-to-r from-sky-400 to-ice-cyan hover:from-sky-300 hover:to-cyan-300 text-slate-950 font-extrabold px-4 py-2.5 rounded-xl text-sm shadow-lg shadow-sky-500/25 transition-all">
                        Регистрация
                    </button>
                `;
            }
        }

        if (auth) {
            onAuthStateChanged(auth, (user) => {
                if (user) {
                    updateHeaderAuth(user.email || "user@leadworld.su");
                } else {
                    updateHeaderAuth(null);
                }
            });
        } else {
            updateHeaderAuth(null);
        }
    </script>

    <!-- General Client App Script -->
    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-ice-cyan', 'bg-sky-500/20', 'shadow-inner');
                el.classList.add('text-slate-300');
            });

            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('nav-' + tabId);
            if(activeBtn) {
                activeBtn.classList.add('text-ice-cyan', 'bg-sky-500/20', 'shadow-inner');
                activeBtn.classList.remove('text-slate-300');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function copyIP() {
            const ip = "play.leadworld.su";
            const textArea = document.createElement("textarea");
            textArea.value = ip;
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand('copy');
                showToast("Морозный IP скопирован: " + ip);
            } catch (err) {
                showToast("Не удалось скопировать IP");
            }
            document.body.removeChild(textArea);
        }

        function buyRank(rankName, price) {
            const email = localStorage.getItem('lw_user_email');
            if(!email) {
                showToast("Пожалуйста, войдите в аккаунт перед покупкой доната!");
                openModal('login');
                return;
            }
            showToast(`Перенаправление на оплату "${rankName}" (${price} руб.) для ${email}...`);
        }

        // Mod Filtering Helper
        window.filterMods = function(category) {
            document.querySelectorAll('#filter-all, #filter-allowed, #filter-forbidden').forEach(btn => {
                btn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all glass-card text-slate-300 hover:border-sky-400/50";
            });

            const activeBtn = document.getElementById('filter-' + category);
            if(category === 'all') activeBtn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-sky-500 text-slate-950 shadow-md";
            if(category === 'allowed') activeBtn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-md";
            if(category === 'forbidden') activeBtn.className = "px-5 py-2.5 rounded-xl text-sm font-semibold transition-all bg-rose-500/20 text-rose-400 border border-rose-500/40 shadow-md";

            document.querySelectorAll('.mod-item').forEach(item => {
                if(category === 'all' || item.getAttribute('data-category') === category) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Snowfall Canvas & Online ticker
        window.onload = function() {
            const canvas = document.getElementById('snow-canvas');
            const ctx = canvas.getContext('2d');
            
            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            const snowflakes = [];
            const maxFlakes = 100;

            for(let i = 0; i < maxFlakes; i++) {
                snowflakes.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: Math.random() * 3 + 1,
                    speed: Math.random() * 1.5 + 0.5,
                    density: Math.random() * 20,
                    opacity: Math.random() * 0.7 + 0.3
                });
            }

            let angle = 0;
            function drawSnow() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.beginPath();
                for(let i = 0; i < maxFlakes; i++) {
                    let f = snowflakes[i];
                    ctx.fillStyle = `rgba(220, 245, 255, ${f.opacity})`;
                    ctx.moveTo(f.x, f.y);
                    ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2, true);
                }
                ctx.fill();
                updateSnow();
            }

            function updateSnow() {
                angle += 0.01;
                for(let i = 0; i < maxFlakes; i++) {
                    let f = snowflakes[i];
                    f.y += f.speed;
                    f.x += Math.sin(angle + f.density) * 0.5;

                    if(f.y > canvas.height) {
                        snowflakes[i] = {
                            x: Math.random() * canvas.width,
                            y: -10,
                            radius: f.radius,
                            speed: f.speed,
                            density: f.density,
                            opacity: f.opacity
                        };
                    }
                }
            }

            setInterval(drawSnow, 30);

            setInterval(() => {
                const onlineEl = document.getElementById('online-count');
                if(onlineEl) {
                    let current = parseInt(onlineEl.innerText.replace(',', ''));
                    let change = Math.floor(Math.random() * 7) - 3;
                    let newOnline = Math.max(1600, Math.min(2350, current + change));
                    onlineEl.innerText = newOnline.toLocaleString();
                }
            }, 4500);
        };
    </script>
</body>
</html>
